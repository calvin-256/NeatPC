# ===========================================
# NeatPC Environment Variables
# Copy this file to .env.local and fill in your keys
# ===========================================

# --- Google Gemini AI ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Database ---
# SQLite for dev (default), Postgres URL for production
# DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/neatpc"

# --- Auth (NextAuth.js) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Retailer APIs (Phase 2) ---
# Amazon Product Advertising API
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=

# Best Buy API
# BESTBUY_API_KEY=

# Walmart Affiliate API
# WALMART_API_KEY=

# --- Email (Phase 5) ---
# RESEND_API_KEY=

# --- Analytics (Phase 6) ---
# NEXT_PUBLIC_GA_ID=
