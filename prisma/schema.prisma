// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================
// User & Auth
// ===========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  savedProducts SavedProduct[]
  priceAlerts   PriceAlert[]
  searchHistory SearchHistory[]
  chatSessions  ChatSession[]
  feedback      Feedback[]
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===========================================
// Products & Pricing
// ===========================================

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String
  category    String   // laptop, phone, desktop, tablet
  slug        String   @unique
  imageUrl    String   @default("")
  description String   @default("")

  // Specs stored as JSON string (flexible schema)
  specsJson   String   @default("{}")

  // Aggregated fields (updated on price sync)
  bestPrice   Float    @default(0)
  dealScore   Int      @default(0) // 0-100
  rating      Float    @default(0) // 0-5
  reviewCount Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  prices        RetailerPrice[]
  priceHistory  PriceHistory[]
  savedBy       SavedProduct[]
  priceAlerts   PriceAlert[]
}

model RetailerPrice {
  id            String   @id @default(cuid())
  productId     String
  retailer      String   // amazon, bestbuy, newegg, bh, walmart
  price         Float
  originalPrice Float?   // MSRP / crossed-out price
  url           String   @default("") // affiliate link
  inStock       Boolean  @default(true)
  lastChecked   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, retailer])
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  retailer   String
  price      Float
  recordedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, retailer, recordedAt])
}

// ===========================================
// User Features
// ===========================================

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model PriceAlert {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  targetPrice Float
  isActive    Boolean  @default(true)
  triggered   Boolean  @default(false)
  triggeredAt DateTime?
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive, triggered])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  filters   String   @default("{}") // JSON string of applied filters
  resultsCount Int   @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ===========================================
// AI Chat
// ===========================================

model ChatSession {
  id          String   @id @default(cuid())
  userId      String?
  quizAnswers String   @default("{}") // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
}

model ChatMessage {
  id            String   @id @default(cuid())
  chatSessionId String
  role          String   // user, assistant, system
  content       String
  productRefs   String   @default("[]") // JSON array of product IDs
  createdAt     DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, createdAt])
}

// ===========================================
// Feedback & Analytics
// ===========================================

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // thumbs_up, thumbs_down, report
  context   String   @default("") // what was the feedback about
  messageId String?  // optional reference to a chat message
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
